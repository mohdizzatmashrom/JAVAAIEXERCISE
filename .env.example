# ======================================================
# .env.example — Template for local development
# ======================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env — it contains real secrets.
# ======================================================

# ---- Server ----
SERVER_PORT=8080

# ---- MongoDB connection ----
MONGODB_HOST=host.docker.internal
MONGODB_PORT=27017
MONGODB_DATABASE=support_desk_db
MONGODB_AUTHENTICATION_DATABASE=admin
MONGODB_USERNAME=appuser
MONGODB_PASSWORD=change_me

# ---- JWT (MUST be at least 32 random bytes for HS256) ----
APP_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_BYTES
APP_JWT_EXPIRATION_MINUTES=60

# ---- Docker Compose host-exposed ports ----
# Port on the host that maps to MongoDB inside the container
MONGO_HOST_PORT=27018
# Port on the host that maps to the backend API container
BACKEND_PORT=8080
# Port on the host that maps to the frontend (Nginx) container
FRONTEND_PORT=5173

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=docker
