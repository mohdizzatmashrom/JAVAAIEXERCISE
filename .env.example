# ======================================================
# .env.example — Placeholder values for Docker runtime
# ======================================================
# Copy this file to .env and replace with real values.
# NEVER commit .env to version control.
# ======================================================

# Server
SERVER_PORT=8080

# MongoDB connection
# Use host.docker.internal when running Docker Desktop to reach host's MongoDB
MONGODB_HOST=host.docker.internal
MONGODB_PORT=27017
MONGODB_DATABASE=support_desk_db
MONGODB_AUTHENTICATION_DATABASE=support_desk_db
MONGODB_USERNAME=appuser
MONGODB_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_bytes
JWT_EXPIRATION_MINUTES=60

# App JWT (used by compose.yaml / Spring Boot app.jwt.secret)
APP_JWT_SECRET=replace_with_a_secure_random_string_at_least_32_bytes
APP_JWT_EXPIRATION_MINUTES=60

# Spring profile
SPRING_PROFILES_ACTIVE=docker
